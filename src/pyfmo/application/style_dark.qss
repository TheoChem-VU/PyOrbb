
QWidget {
    border: none;
    /*background-color: transparent;*/
    border-radius: 5px;
}

QPushButton {
    font: 12px "Inter";
    color: #e0e0e0;
    /*border: none;*/
    border: 1px solid #242424;
    border-radius: 5px;
    padding: 4px;
    background-color: #323232;
    }
QPushButton:hover {
    background-color: #404040;
}
QPushButton:checked {
    background-color: #242424;
}
QPushButton::disabled {
    font: 12px "Inter";
    color: #666666;
    border: none;
    border-radius: 5px;
    padding: 4px;
    background-color: #242424;
    }

QWidget#Outline {
    border: 1.5px dashed #242424;
    padding: 40px;
    border-radius: 10px;
    background-color: #323232;
    margin-top: 10px;
    margin-left: 10px;
    margin-right: 10px;
}
QWidget#drop_area {
    border: 1px solid #242424;
    background-color: #323232;
    border-radius: 20px;
    margin-left: 60px;
    margin-right: 60px;
    margin-top: 5px;
}
QWidget#carousel {
    padding-left: 15px;
    padding-right: 15px;
    margin-left: 120px;
    margin-right: 120px;
    background-color: transparent;
}

QDialog {
    background: #323232;
    border: none;
    border-radius: 5px; 
}

QLabel {
    border: none;
    font: 12px "Inter";
    color: #e0e0e0;
    padding: 3px;
}

QLabel#orbital_table {
    padding: 0px;
}
QLabel#carousel_title {
    font: 20px "Inter";
    color: #a0a0a0;
    margin-left: 120px;
    margin-top: 15px;
}

QTabWidget { 
    border-radius: 5px; 
    border: 1px solid darkgray
} 
QTabWidget::pane { 
    border: 1px solid #242424; 
    background-color: #3F3F3F;
    border-radius: 10px; 
    border-top-left-radius: 0px;
    top: -1px;
} 
