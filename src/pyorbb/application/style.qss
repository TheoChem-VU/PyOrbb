
QWidget {
    border: none;
    /*background-color: transparent;*/
    border-radius: 5px;
}

QCheckBox {
    font: 12px "Inter";
    color: #1f2022;
    padding: 4px;
    }
QPushButton {
    font: 12px "Inter";
    color: #1f2022;
    /*border: none;*/
    border: 1px solid #d0d0d0;
    border-radius: 5px;
    padding: 4px;
    background-color: white;
    }
QPushButton:hover {
    background-color: #f6f6f6;
}
QPushButton:checked {
    background-color: #d0d0d0;
}
QPushButton::disabled {
    font: 12px "Inter";
    color: #a2a7b2;
    border: none;
    border-radius: 5px;
    padding: 4px;
    background-color: lightgray;
    }

QWidget#Outline {
    border: 1.5px dashed lightgray;
    padding: 40px;
    border-radius: 10px;
    background-color: white;
    margin-top: 10px;
    margin-left: 10px;
    margin-right: 10px;
}
QWidget#drop_area {
    border: 1px solid #d0d0d0;
    background-color: white;
    border-radius: 20px;
    margin-left: 60px;
    margin-right: 60px;
    margin-top: 5px;
}
QWidget#carousel {
    /*padding: 15px;*/
    margin-left: 120px;
    margin-right: 120px;
    background-color: transparent;
}

QDialog {
    background-color: none;
    border: none;
    border-radius: 5px; 
}

QLabel {
    border: none;
    font: 12px "Inter";
    color: #1f2022;
    padding: 3px;
}

QLabel#orbital_table {
    padding: 0px;
}

QLabel#carousel_title {
    font: 20px "Inter";
    color: #808080;
    margin-left: 120px;
    margin-top: 15px;
}

/*
QTabWidget { 
    border-radius: 5px; 
    border: 1px solid lightgray;
} */


QTabWidget::pane:top { 
    border: 1px solid #A9A9A9;
    background-color: #F7F7F7;
    border-radius: 10px;
    border-top-left-radius: 0px;
    top: -1px;
} 

QTabWidget::pane:left { 
    border: 1px solid #A9A9A9;
    background-color: #F7F7F7;
    border-radius: 10px;
    border-top-left-radius: 0px;
    left: -1px;
} 


