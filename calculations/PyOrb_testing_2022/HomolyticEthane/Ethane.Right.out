    2 H      -0.092   -1.372   -0.464   -0.116   -1.233   -0.349   -0.131   -1.326   -0.456    0.008
    3 H      -0.092   -1.372   -0.464   -0.116   -1.233   -0.349   -0.131   -1.326   -0.456    0.008
    4 H      -0.092   -1.372   -0.464   -0.116   -1.233   -0.349   -0.131   -1.326   -0.456    0.008
 ---------------------------------------------------------------------------------------------------
