#!/bin/sh

"$AMSBIN/ams" << eor

Task SinglePoint
System
    Atoms
        P 0.0 0.0 0.0 region=P
    End
    Symmetrize Yes
    Charge 5
End
Symmetry
    SymmetrizeTolerance 1.0e-7
End

Engine ADF
    Basis
        Type TZ2P
        Core None
    End
    XC
        GGA OLYP
    End
    Title P fragment
    Symmetry NOSYM
    NumericalQuality Good
EndEngine
eor

