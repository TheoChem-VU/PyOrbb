#!/bin/sh

"$AMSBIN/ams" << eor

Task SinglePoint
System
    Atoms
        Na 0.0 0.0 0.0 region=Na
    End
    Symmetrize Yes
    Charge 1
End
Symmetry
    SymmetrizeTolerance 1.0e-7
End

Engine ADF
    Basis
        Type QZ4P
        Core None
    End
    ALLOW  FRACTIONAL
    XC
        GGA BLYP
    End
    Title Na fragment
    Symmetry ATOM
    NumericalQuality VeryGood
EndEngine
eor

