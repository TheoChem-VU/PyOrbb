#!/bin/sh

"$AMSBIN/ams" << eor

Task SinglePoint
System
    Atoms
        Cl 0.0 0.0 0.0 region=Cl
    End
    Symmetrize Yes
    Charge 1
End
Symmetry
    SymmetrizeTolerance 1.0e-7
End

Engine ADF
    Basis
        Type TZ2P
        Core None
    End
    ALLOW  FRACTIONAL
    XC
        GGA OLYP
    End
    Title Cl fragment
    Symmetry ATOM
    NumericalQuality Good
EndEngine
eor

