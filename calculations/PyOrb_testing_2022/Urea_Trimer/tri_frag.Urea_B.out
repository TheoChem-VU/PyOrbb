    2 O      -3.213   -4.925   -0.138   -3.423   -4.718   -0.141   -3.248   -5.261   -0.509   -0.370
    3 N      -2.332   -3.600    1.068   -2.497   -3.717    0.786   -2.363   -3.764    0.873   -0.195
    4 N      -2.332   -3.597    1.071   -2.497   -3.715    0.788   -2.363   -3.762    0.875   -0.196
    5 H      -0.098   -1.478   -0.576   -0.109   -1.325   -0.434   -0.131   -1.297   -0.428    0.148
