    2 C      -2.151   -2.852    0.997   -2.252   -3.011    0.737   -2.174   -2.875    0.951   -0.046
    3 H      -0.080   -1.416   -0.496   -0.104   -1.253   -0.356   -0.116   -1.334   -0.450    0.046
    4 H      -0.080   -1.426   -0.507   -0.104   -1.266   -0.370   -0.117   -1.355   -0.473    0.034
    5 H      -0.080   -1.424   -0.504   -0.104   -1.264   -0.368   -0.117   -1.353   -0.471    0.033
