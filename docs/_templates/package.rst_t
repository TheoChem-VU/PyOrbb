{# copy-pasted from sphinx/templates/apidoc/package.rst_t, but makes
   "Subpackages", "Submodules", and "Module Contents" simple text instead
   of headings #}
{%- macro automodule(modname, options) -%}
.. automodule:: {{ modname }}
{%- for option in options %}
   :{{ option }}:
{%- endfor %}
{%- endmacro %}

{%- macro toctree(docnames) -%}
.. toctree::
   :maxdepth: {{ maxdepth }}
{% for docname in docnames %}
   {{ docname }}
{%- endfor %}
{%- endmacro %}


{%- if subpackages %}
Subpackages:

{{ toctree(subpackages) }}
{% endif %}

{%- if submodules %}
Submodules:

{% if separatemodules %}
{{ toctree(submodules) }}
{% else %}
{%- for submodule in submodules %}
{% if show_headings %}
{{- [submodule] | join(" ") | e | heading(2) }}
{% endif %}
{{ automodule(submodule, automodule_options) }}
{% endfor %}
{%- endif %}
{%- endif %}

{%- if not modulefirst and not is_namespace %}
Module contents:

{{ automodule(pkgname, automodule_options) }}
{% endif %}